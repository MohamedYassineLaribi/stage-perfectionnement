## 6. Code Source du Dashboard (React Frontend)

Exemple typique d'affichage dynamique avec cartes de KPI et graphique Chart.js pour le Dashboard.

```jsx
import React, { useState, useEffect } from 'react';
import { Row, Col, Card } from 'react-bootstrap';
import { Doughnut, Bar } from 'react-chartjs-2';
import api from '../services/api';
import { Chart as ChartJS, ArcElement, Tooltip, Legend, CategoryScale, LinearScale, BarElement } from 'chart.js';

ChartJS.register(ArcElement, Tooltip, Legend, CategoryScale, LinearScale, BarElement);

const Dashboard = () => {
    const [stats, setStats] = useState({
        totalClients: 0,
        totalOffers: 0,
        totalInvoices: 0,
        recentActivities: []
    });

    useEffect(() => {
        const fetchDashboardData = async () => {
            try {
                // Appel API pour récupérer les statistiques réelles
                const { data } = await api.get('/dashboard/stats');
                setStats(data);
            } catch (error) {
                console.error('Erreur lors du chargement des statistiques', error);
            }
        };
        fetchDashboardData();
    }, []);

    const chartData = {
        labels: ['Jan', 'Fév', 'Mar', 'Avr', 'Mai', 'Jui'],
        datasets: [{
            label: 'Revenus (€)',
            data: [12000, 19000, 3000, 5000, 2000, 30000],
            backgroundColor: 'rgba(54, 162, 235, 0.6)',
        }]
    };

    return (
        <div className="dashboard-container">
            <h2 className="mb-4">Vue d'ensemble</h2>
            
            <Row className="mb-4">
                <Col md={4}>
                    <Card className="shadow-sm widget-card text-center">
                        <Card.Body>
                            <Card.Title>Total Clients</Card.Title>
                            <h3>{stats.totalClients}</h3>
                        </Card.Body>
                    </Card>
                </Col>
                <Col md={4}>
                    <Card className="shadow-sm widget-card text-center">
                        <Card.Body>
                            <Card.Title>Offres Emises</Card.Title>
                            <h3>{stats.totalOffers}</h3>
                        </Card.Body>
                    </Card>
                </Col>
                <Col md={4}>
                    <Card className="shadow-sm widget-card text-center">
                        <Card.Body>
                            <Card.Title>Factures Payées</Card.Title>
                            <h3>{stats.totalInvoices}</h3>
                        </Card.Body>
                    </Card>
                </Col>
            </Row>

            <Row>
                <Col md={8}>
                    <Card className="shadow-sm">
                        <Card.Body>
                            <Card.Title>Évolution des Revenus</Card.Title>
                            <Bar data={chartData} options={{ responsive: true }} />
                        </Card.Body>
                    </Card>
                </Col>
                <Col md={4}>
                    {/* ... liste des activités récentes ... */}
                </Col>
            </Row>
        </div>
    );
};

export default Dashboard;
```
